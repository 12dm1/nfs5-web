[Unit]
Description=nfs5-web: the browser game (page, module, game files) for nginx on 127.0.0.1:9460
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/nfs5-web
ExecStart=/usr/bin/node /opt/nfs5-web/web/server.mjs --public --port 9460 --host 127.0.0.1 --data /opt/nfs5-web/data --mod /opt/nfs5-web/mod --music /opt/nfs5-web/music --addons /opt/nfs5-web/addons --exe /opt/nfs5-web/out/PORSCHE.EXE --cars "" --logs /var/lib/nfs5-web
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/nfs5-web
StateDirectory=nfs5-web
MemoryMax=600M

[Install]
WantedBy=multi-user.target
